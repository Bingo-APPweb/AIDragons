{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "bbf-tables",
  "version": "0.0.0-development",
  "description": "BBF Tables - Natural Prediction & Temporal Anomaly Detection System",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "size-limit": [
    {
      "path": "dist/index.js",
      "limit": "15 kB",
      "webpack": false,
      "gzip": true
    },
    {
      "path": "dist/index.cjs",
      "limit": "16 kB",
      "webpack": false,
      "gzip": true
    }
  ],
  "scripts": {
    "test:property": "jest --config=jest.config.js --testMatch='**/*.prop.test.ts' --verbose",
    "prepare": "husky install",
    "build": "tsup src/index.ts --dts --format esm,cjs --sourcemap --clean",
    "api:build": "npm run build",
    "api:check": "api-extractor run --local && git diff --exit-code ./temp/*.api.json || (echo '❌ API changed: bump semver' && exit 1)",
    "size": "size-limit",
    "size:check": "size-limit --why",
    "verify:release": "if ($?) { powershell -ExecutionPolicy Bypass -File scripts/verify-release.ps1 } else { echo 'Error: PowerShell is required for this script' }",
    "dev": "tsup src/index.ts --dts --format esm --watch",
    "test": "jest --detectOpenHandles --forceExit",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:fft": "jest src/natural-prediction/core/fft-weak-signal.test.ts",
    "test:waves": "jest src/natural-prediction/analyzers/standing-waves.test.ts",
    "test:evolution": "jest src/natural-prediction/evolution/weight-optimizer.test.ts",
    "test:chaos": "jest src/natural-prediction/analyzers/lyapunov-chaos.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "typecheck": "tsc --noEmit",
    "docs": "typedoc",
    "docs:serve": "npx http-server docs -p 8080",
    "example:basic": "ts-node examples/basic-usage.ts",
    "precommit": "lint-staged",
    "prettier:check": "prettier --check .",
    "prettier:write": "prettier --write .",
    "semantic-release": "semantic-release",
    "sbom": "cyclonedx-npm --output-format json --output-file sbom.json"
  },
  "dependencies": {
    "fft-js": "^0.0.12",
    "mathjs": "^11.8.0",
    "ml-matrix": "^6.10.4",
    "numeric": "^1.2.6",
    "rxjs": "^7.8.1",
    "simple-statistics": "^7.8.3",
    "ts-node": "^10.9.0"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.41.2",
    "@microsoft/api-extractor-model": "^7.41.2",
    "@size-limit/preset-small-lib": "^12.2.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.0.0",
    "@types/numeric": "^1.2.3",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-prettier": "^5.1.3",
    "husky": "^9.0.11",
    "jest": "^29.7.0",
    "lint-staged": "^15.2.2",
    "prettier": "^3.3.3",
    "pretty-quick": "^4.0.0",
    "size-limit": "^12.2.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typedoc": "^0.25.8",
    "typedoc-plugin-markdown": "^3.17.0",
    "typescript": "^5.9.2"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,md,yaml,yml}": [
      "prettier --write"
    ],
    "*.{ts,tsx}": [
      "eslint --fix"
    ]
  },
  "publishConfig": {
    "access": "public",
    "provenance": "true"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bbf-tables/bbf-tables.git"
  },
  "bugs": {
    "url": "https://github.com/bbf-tables/bbf-tables/issues"
  },
  "homepage": "https://github.com/bbf-tables/bbf-tables#readme"
}
