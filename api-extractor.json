{
  "$schema": "https://developer.microsoft.com/json-schemas/api-extractor/v7/api-extractor.schema.json",
  "mainEntryPointFilePath": "dist/index.d.ts",
  "apiReport": {
    "enabled": true,
    "reportFileName": "bbf-tables.api.md",
    "reportTempFolder": "./temp"
  },
  "docModel": {
    "enabled": true,
    "apiJsonFilePath": "temp/bbf-tables.api.json"
  },
  "dtsRollup": {
    "enabled": true,
    "untrimmedFilePath": "dist/bbf-tables.d.cts"
  },
  "tsdocMetadata": {
    "enabled": false
  },
  "messages": {
    "tsdocMessageReporting": {
      "default": {
        "logLevel": "none"
      }
    },
    "extractorMessageReporting": {
      "ae-missing-release-tag": {
        "logLevel": "none"
      },
      "ae-forgotten-export": {
        "logLevel": "warning"
      }
    }
  }
}
